{
  "name": "tenrankai-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:legacy && vite build && npm run build:admin",
    "build:prod": "npm run build:legacy && vite build --mode production && npm run build:admin",
    "build:legacy": "tsc -p tsconfig.legacy.json",
    "build:admin": "cd admin && npm run build",
    "watch:legacy": "tsc -p tsconfig.legacy.json --watch",
    "dev": "vite",
    "dev:admin": "cd admin && npm run dev",
    "dev:open": "vite --open",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc -p tsconfig.legacy.json --noEmit",
    "lint:css": "stylelint \"static/**/*.css\"",
    "lint:css-vars": "node scripts/validate-css-variables.js",
    "lint": "npm run type-check && npm run lint:css && npm run lint:css-vars",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"const fs = require('fs'); ['static/dist', 'static/js', 'static/admin', 'node_modules/.vite'].forEach(dir => fs.rmSync(dir, { recursive: true, force: true }));\"",
    "help": "echo 'Development: npm run dev (+ cargo run in another terminal)'"
  },
  "dependencies": {
    "@tiptap/extension-link": "^2.1.0",
    "@tiptap/extension-placeholder": "^2.1.0",
    "@tiptap/react": "^2.1.0",
    "@tiptap/starter-kit": "^2.1.0",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.0",
    "@uppy/react": "^5.1.1",
    "@uppy/tus": "^5.1.0",
    "marked": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "turndown": "^7.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/turndown": "^5.0.4",
    "@types/web": "^0.0.99",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^28.0.0",
    "msw": "^2.12.9",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  }
}

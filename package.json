{
  "name": "tenrankai-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite build && npm run build:admin",
    "build:prod": "vite build --mode production && npm run build:admin",
    "build:admin": "cd admin && npm install --silent && npm run build",
    "dev": "vite",
    "dev:admin": "cd admin && npm run dev",
    "dev:open": "vite --open",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint:css": "stylelint \"static/**/*.css\"",
    "lint:css-vars": "node scripts/validate-css-variables.js",
    "lint": "npm run type-check && npm run lint:css && npm run lint:css-vars",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "clean": "node -e \"const fs = require('fs'); ['static/dist', 'static/admin', 'node_modules/.vite'].forEach(dir => fs.rmSync(dir, { recursive: true, force: true }));\"",
    "help": "echo 'Development: npm run dev (+ cargo run in another terminal)'"
  },
  "dependencies": {
    "@seiza/astro-overlay": "^0.7.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@uppy/core": "^6.3.0",
    "@uppy/dashboard": "^6.0.2",
    "@uppy/react": "^6.1.0",
    "@uppy/tus": "^6.0.0",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/web": "^0.0.359",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

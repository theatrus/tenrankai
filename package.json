{
  "name": "tenrankai-frontend",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "dev": "vite",
    "preview": "vite preview",
    "legacy:build": "tsc && npm run copy-assets",
    "legacy:watch": "tsc --watch & npm run watch-assets",
    "copy-assets": "cp -r src/assets/* static/ 2>/dev/null || true",
    "watch-assets": "chokidar 'src/assets/**/*' -c 'npm run copy-assets'"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "chokidar-cli": "^3.0.0", 
    "@types/web": "^0.0.99"
  }
}
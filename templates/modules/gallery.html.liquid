{% if folder_title %}
    {% assign page_title = folder_title %}
{% else %}
    {% assign page_title = "Gallery" %}
{% endif %}
{% assign meta_description = folder_description | default: "Browse the photo gallery on theatr.us" | strip_html | truncate: 160 %}
{% assign page_css = "gallery-filters.css,editor.css,gallery-manage.css,share-modal.css" | split: "," %}
{% include "_header.html.liquid" %}

<div class="container gallery-container">
    <!-- Navigation Breadcrumb -->
    <nav class="gallery-nav">
        {% for crumb in breadcrumbs %}
            {% unless forloop.first %}
                <span class="nav-separator">→</span>
            {% endunless %}
            {% if crumb.is_current %}
                <span class="nav-current">{{ crumb.display_name }}</span>
            {% else %}
                <a href="{{ gallery_url }}{% if crumb.path != "" %}/{{ crumb.path }}{% endif %}" class="nav-link">{{ crumb.display_name }}</a>
            {% endif %}
        {% endfor %}
    </nav>

    <div class="gallery-header">
        <!-- Folder title and description - React will enhance this if user has edit permission -->
        <div id="folder-description-mount"
             class="gallery-title-section"
             data-can-edit="{{ permissions.can_edit_content }}"
             data-gallery-name="{{ gallery_name }}"
             data-gallery-path="{{ gallery_path }}"
             data-folder-title="{{ folder_title }}">
            {% if folder_title %}
                <h2 class="folder-title">{{ folder_title }}</h2>
            {% endif %}
            {% if folder_description %}
                <div class="folder-description">
                    {{ folder_description }}
                </div>
            {% endif %}
        </div>

        <div class="gallery-actions">
            <!-- Filter bar will be injected here by React if user has permissions -->
            <div id="gallery-filter-mount"></div>

            <div id="gallery-share-mount" style="display: inline-block;"></div>

            {% if permissions.can_download_gallery %}
                <a href="{{ gallery_url }}/_download{% if gallery_path != '' %}/{{ gallery_path }}{% endif %}" class="btn btn-secondary" title="Download all images as ZIP">
                    Download
                </a>
            {% endif %}

            {% if permissions.can_manage_images %}
                <div id="new-dropdown-mount" style="display: inline-block;"></div>
                <button id="manage-images-btn" class="btn btn-secondary" title="Edit images">
                    Edit
                </button>
            {% endif %}

            {% if permissions.owner_access %}
                <a href="/_admin/galleries/{{ gallery_name }}/folders/{% if gallery_path != '' %}{{ gallery_path | url_encode }}{% else %}_root{% endif %}" class="btn btn-secondary" title="Manage folder access and permissions">
                    Access
                </a>
            {% endif %}

            {% assign directories = items | where: "is_directory", true %}
            {% if permissions.can_manage_images and gallery_path != '' and images.size == 0 and directories.size == 0 %}
                <button id="delete-folder-btn" class="btn btn-danger" title="Delete this empty folder"
                        data-gallery-name="{{ gallery_name }}"
                        data-folder-path="{{ gallery_path }}"
                        data-folder-name="{{ folder_title | default: gallery_path | split: '/' | last }}">
                    Delete Folder
                </button>
            {% endif %}
        </div>
    </div>
    
    <!-- Embedded gallery data for React component (always present for +New dropdown) -->
    <script type="application/json" id="gallery-data">
{{ gallery_data_json }}
    </script>

    {% if items.size > 0 %}
        <!-- Directory Navigation -->
        {% assign directories = items | where: "is_directory", true %}
        {% if directories.size > 0 %}
            <div class="gallery-folders">
                <div class="folder-grid">
                    {% for dir in directories %}
                        <a href="{{ gallery_url }}/{{ dir.path }}" class="folder-item">
                            <div class="folder-preview">
                                {% if dir.preview_images and dir.preview_images.size > 0 %}
                                    <div class="preview-images">
                                        {% for image_url in dir.preview_images limit: 4 %}
                                            <img src="{{ image_url }}" alt="Preview" loading="lazy" class="preview-img preview-img-{{ forloop.index }}">
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="folder-icon">📁</div>
                                {% endif %}
                            </div>
                            <div class="folder-info">
                                <div class="folder-name">
                                    {% if dir.display_name %}
                                        {{ dir.display_name }}
                                    {% else %}
                                        {{ dir.name }}
                                    {% endif %}
                                </div>
                                <div class="folder-count">{{ dir.item_count }} images</div>
                                {% if dir.description %}
                                    <div class="folder-description-preview">{{ dir.description | strip_html | truncate: 100 }}</div>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <!-- Image Gallery (React renders into this container) -->
        {% if images.size > 0 %}
            <div class="gallery-images">
                <!-- React will render the masonry grid here -->
            </div>

            <!-- Image data for React -->
            <script type="application/json" id="gallery-images">
{{ images_json }}
            </script>
        {% endif %}
    {% else %}
        <p class="empty-gallery">No images found in this directory.</p>
    {% endif %}
</div>


<!-- Gallery URL for React component -->
<div data-gallery-url="{{ gallery_url }}" style="display: none"></div>

{% include "_footer.html.liquid" %}
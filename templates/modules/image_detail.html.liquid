{% assign page_title = image.name %}
{% assign meta_description = image.description | default: "View this image on theatr.us gallery" | strip_html | truncate: 160 %}

{% comment %} Open Graph tags for image {% endcomment %}
{% assign og_title = image.name %}
{% assign og_description = meta_description %}
{% assign og_image = base_url | append: image.gallery_url %}
{% if image.dimensions %}
    {% assign og_image_width = image.dimensions[0] %}
    {% assign og_image_height = image.dimensions[1] %}
{% endif %}
{% assign og_type = "article" %}
{% assign og_url = base_url | append: gallery_url | append: "/detail/" | append: image.path %}

{% comment %} Twitter Card tags {% endcomment %}
{% assign twitter_card_type = "summary_large_image" %}
{% assign twitter_title = image.name %}
{% assign twitter_description = meta_description %}
{% assign twitter_image = og_image %}
{% assign page_css = "image-detail.css" | split: "," %}

{% include "_header.html.liquid" %}

<div class="container container-lg image-detail-container">

    <!-- React Image Detail Mount Point -->
    <div id="react-image-detail" 
         data-gallery-url="{{ gallery_url }}"
         data-hide-metadata="{{ hide_technical_details }}"></div>

    <!-- Embedded JSON data for React component -->
    <script type="application/json" id="image-detail-data">
    {
      "gallery_name": {{ gallery_name | json }},
      "image": {
        "path": {{ image.path | json }},
        "name": {{ image.name | json }},
        {% if image.title %}"title": {{ image.title | json }},{% endif %}
        {% if image.description %}"description": {{ image.description | json }},{% endif %}
        "dimensions": {{ image.dimensions | json }},
        {% if image.capture_date %}"capture_date": {{ image.capture_date | json }},{% endif %}
        "file_size": {{ image.file_size | json }},
        "thumbnail_url": {{ image.thumbnail_url | json }},
        {% if image.gallery_url %}"gallery_url": {{ image.gallery_url | json }},{% endif %}
        "medium_url": {{ image.medium_url | json }},
        {% if image.large_url %}"large_url": {{ image.large_url | json }},{% endif %}
        {% unless hide_technical_details %}{% if image.camera_info %}
        "camera_info": {
          {% if image.camera_info.camera_make %}"camera_make": {{ image.camera_info.camera_make | json }},{% endif %}
          {% if image.camera_info.camera_model %}"camera_model": {{ image.camera_info.camera_model | json }},{% endif %}
          {% if image.camera_info.lens_model %}"lens_model": {{ image.camera_info.lens_model | json }},{% endif %}
          {% if image.camera_info.iso %}"iso": {{ image.camera_info.iso | json }},{% endif %}
          {% if image.camera_info.aperture %}"aperture": {{ image.camera_info.aperture | json }},{% endif %}
          {% if image.camera_info.shutter_speed %}"shutter_speed": {{ image.camera_info.shutter_speed | json }},{% endif %}
          {% if image.camera_info.focal_length %}"focal_length": {{ image.camera_info.focal_length | json }}{% endif %}
        },
        {% endif %}{% endunless %}
        {% if image.location_info %}
        "location_info": {
          "latitude": {{ image.location_info.latitude | json }},
          "longitude": {{ image.location_info.longitude | json }},
          "google_maps_url": {{ image.location_info.google_maps_url | json }},
          "apple_maps_url": {{ image.location_info.apple_maps_url | json }}
        },
        {% endif %}
        {% unless hide_technical_details %}{% if image.color_profile %}"color_profile": {{ image.color_profile | json }},{% endif %}{% endunless %}
        "is_new": {{ image.is_new | json }}
      },
      "breadcrumbs": {{ breadcrumbs | json }},
      {% if prev_image %}
      "prev_image": {
        "path": {{ prev_image.path | json }},
        "name": {{ prev_image.name | json }},
        "thumbnail_url": {{ prev_image.thumbnail_url | json }}
      },
      {% endif %}
      {% if next_image %}
      "next_image": {
        "path": {{ next_image.path | json }},
        "name": {{ next_image.name | json }},
        "thumbnail_url": {{ next_image.thumbnail_url | json }}
      }
      {% endif %}
    }
    </script>
</div>

<!-- React Component Loading -->
<script type="module" src="{{ "dist/image-detail.js" | asset_url }}"></script>

{% include "_footer.html.liquid" %}

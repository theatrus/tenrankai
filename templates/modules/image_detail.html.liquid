{% assign page_title = image.name %}
{% comment %} Use AI alt-text if available, otherwise fall back to description or default {% endcomment %}
{% if image.user_metadata.ai_alt_text %}
    {% assign meta_description = image.user_metadata.ai_alt_text | strip_html | truncate: 160 %}
{% else %}
    {% if image.media_kind == "video" %}
        {% assign default_image_description = "Watch this video on " | append: site_title | append: " gallery" %}
    {% else %}
        {% assign default_image_description = "View this image on " | append: site_title | append: " gallery" %}
    {% endif %}
        {% assign meta_description = image.description | default: default_image_description | strip_html | truncate: 160 %}
{% endif %}

{% comment %} Open Graph metadata for photos and prepared video playback. {% endcomment %}
{% assign og_title = image.name %}
{% assign og_description = meta_description %}
{% assign og_image = base_url | append: image.gallery_url %}
{% if image.dimensions and image.media_kind != "video" %}
    {% assign og_image_width = image.dimensions[0] %}
    {% assign og_image_height = image.dimensions[1] %}
{% endif %}
{% assign og_type = "article" %}
{% assign og_url = base_url | append: gallery_url | append: "/detail/" | append: image.path %}
{% if image.media_kind == "video" %}
    {% assign og_type = "video.other" %}
    {% if allow_video_embedding and image.video.playback_url %}
        {% assign og_video = base_url | append: image.video.playback_url %}
        {% assign og_video_type = "video/mp4" %}
        {% assign base_url_scheme = base_url | slice: 0, 8 %}
        {% if base_url_scheme == "https://" %}
            {% assign og_video_secure_url = og_video %}
        {% endif %}
        {% if video_dimensions %}
            {% assign og_video_width = video_dimensions[0] %}
            {% assign og_video_height = video_dimensions[1] %}
        {% endif %}
    {% else %}
        {% assign og_description = "Click to play this video on " | append: site_title | append: ". " | append: meta_description | truncate: 200 %}
    {% endif %}
{% endif %}

{% comment %} Twitter Card tags {% endcomment %}
{% assign twitter_card_type = "summary_large_image" %}
{% assign twitter_title = image.name %}
{% assign twitter_description = og_description %}
{% assign twitter_image = og_image %}
{% assign page_css = "image-detail.css,editor.css,share-modal.css" | split: "," %}

{% include "_header.html.liquid" %}

<div class="container container-lg image-detail-container">

    <!-- React Image Detail Mount Point -->
    <div id="react-image-detail" 
         data-gallery-url="{{ gallery_url }}"
         data-authenticated="{{ is_authenticated }}"
         data-current-user="{{ current_user }}"></div>

    <noscript>
    {% if image.media_kind == "video" %}
      {% if image.video.playback_url %}
        <video controls playsinline preload="metadata" poster="{{ image.medium_url | escape }}" src="{{ image.video.playback_url | escape }}" aria-label="{{ image.name | escape }}" style="max-width:100%"></video>
      {% else %}
        <p>Preparing video for playback. Reload this page to check progress.</p>
      {% endif %}
    {% else %}
      <img src="{{ image.medium_url | escape }}" alt="{{ image.name | escape }}" style="max-width:100%">
    {% endif %}
    </noscript>

    <!-- Embedded JSON data for React component -->
    <script type="application/json" id="image-detail-data">
    {{ image_detail_json }}
    </script>
</div>

{% include "_footer.html.liquid" %}
